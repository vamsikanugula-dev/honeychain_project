# ===========================================================================
# HoneyChain API — DEVELOPMENT overrides
# Copy to `backend/.env.development`. Loaded last, so it wins over `.env`.
# Aimed at a single developer machine: readable logs, permissive local CORS.
# ===========================================================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_JSON=false                       # human-readable console output

# Local PostgreSQL 15+ (uses the built-in gen_random_uuid(); no extension needed)
DATABASE_URL=postgresql+psycopg://honeychain:honeychain_dev_password@localhost:5432/honeychain_dev
DATABASE_ECHO=false                  # set true to print every SQL statement

# Local dev secret — convenient, NOT for any shared or deployed environment.
JWT_SECRET_KEY=dev-only-secret-replace-before-deploying-anywhere-else-0123456789
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60   # longer sessions while developing
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# Vite dev server (default port). Add team members' origins as needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Handy while building the auth flow with Postman/curl: the refresh token is
# returned in the response body instead of only as an HttpOnly cookie.
AUTH_EXPOSE_REFRESH_IN_BODY=true
