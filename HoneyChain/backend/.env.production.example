# ===========================================================================
# HoneyChain API — PRODUCTION overrides
# Copy to `backend/.env.production` on the server (or inject as real environment
# variables / secrets manager entries). Never commit the filled-in file.
#
# Startup performs a safety check and REFUSES to boot if:
#   * JWT_SECRET_KEY is still the placeholder or shorter than 32 characters
#   * DEBUG is true
#   * CORS_ORIGINS is empty or contains "*"
# ===========================================================================

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true                        # ship structured JSON to the log collector

# Managed PostgreSQL. Prefer a secret-managed value; restrict the role to the
# application database only and require TLS (sslmode=require).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/honeychain?sslmode=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Generate a unique 64-byte secret per environment, rotated on a schedule.
JWT_SECRET_KEY=REPLACE_WITH_A_64_BYTE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=20
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cross-site cookies require HTTPS + SameSite=None.
COOKIE_DOMAIN=.honeychain.example.gov.in
COOKIE_SAMESITE=none
AUTH_EXPOSE_REFRESH_IN_BODY=false    # browser clients use the HttpOnly cookie

# Explicit production origins only — never "*".
CORS_ORIGINS=https://honeychain.example.gov.in

BLOCKCHAIN_NETWORK=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
AI_API_KEY=
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
