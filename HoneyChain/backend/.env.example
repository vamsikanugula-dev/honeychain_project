# ===========================================================================
# HoneyChain API — environment template
# Copy to `backend/.env` and fill in real values. NEVER commit `backend/.env`.
#
#   cp backend/.env.example backend/.env
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   # JWT secret
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
PROJECT_NAME=HoneyChain
ENVIRONMENT=development              # development | testing | production
DEBUG=false
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL — required; SQLite is only used by the test suite)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://honeychain:change-me@localhost:5432/honeychain_dev
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Authentication
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# The placeholder below is rejected at startup when ENVIRONMENT=production.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=honeychain-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh-token cookie (browser clients). Leave COOKIE_DOMAIN empty for localhost.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax                  # lax | strict | none
# Set to true only for non-browser clients that need the token in the JSON body.
AUTH_EXPOSE_REFRESH_IN_BODY=false

# ---------------------------------------------------------------------------
# CORS — comma-separated explicit origins. "*" is rejected in production.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Hyperledger Fabric traceability service (Phase 8)
# This is backend-only configuration. Never expose this host to browser code.
# ---------------------------------------------------------------------------
BLOCKCHAIN_BASE_URL=http://54.160.152.176:3001
BLOCKCHAIN_TIMEOUT_MS=10000
BLOCKCHAIN_RETRY_ATTEMPTS=3
BLOCKCHAIN_ENABLED=true
# Temporary, backend-enforced development/demo risk override. Disable in production.
LAB_ALLOW_RISK_OVERRIDE=true

# Legacy variables are accepted for old deployments but are not used by Phase 8.
BLOCKCHAIN_NETWORK=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# AI / ML service (Phase 5 — placeholder, not used yet)
# ---------------------------------------------------------------------------
AI_API_KEY=

# ---------------------------------------------------------------------------
# IoT telemetry (Phase 3 — implemented)
#
# The MQTT broker is OPTIONAL. Leave MQTT_BROKER_URL empty and the API, the HTTP
# ingest endpoint (POST /api/v1/iot/telemetry) and every dashboard still work;
# GET /api/v1/health/mqtt then answers "not_configured" and says so in words.
# Set it to a broker host to receive device packets over MQTT as well.
# See docs/iot.md for the full contract.
# ---------------------------------------------------------------------------
MQTT_BROKER_URL=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=honeychain-backend
# Root of every topic: <prefix>/devices/{device_id}/{telemetry|status|commands|config}
MQTT_TOPIC_PREFIX=honeychain
MQTT_USE_TLS=false
MQTT_KEEPALIVE_SECONDS=60
MQTT_RECONNECT_SECONDS=5
# Set false to run the API without the consumer thread (e.g. a dedicated consumer process)
MQTT_CONSUMER_ENABLED=true

# Device health: a device that has not reported for this long is OFFLINE, so a
# device that goes quiet stops looking healthy by itself. A reporting device at or
# below DEVICE_LOW_BATTERY_PERCENT is WARNING.
DEVICE_OFFLINE_THRESHOLD_SECONDS=900
DEVICE_LOW_BATTERY_PERCENT=20

# Ingest limits. Values outside the sensor validity ranges are rejected with 422,
# never clamped; a payload larger than this is refused before it is parsed, and a
# timestamp further into the future than the skew allowance is a clock error.
TELEMETRY_MAX_PAYLOAD_BYTES=8192
TELEMETRY_MAX_CLOCK_SKEW_SECONDS=300
# Telemetry is audited at most this often per device, keeping audit_logs meaningful.
TELEMETRY_AUDIT_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true                        # true = structured JSON (prod), false = readable

# ---------------------------------------------------------------------------
# Optional bootstrap administrator (used by `python -m app.scripts.create_admin`)
# Leave blank to skip. Never commit real credentials.
# ---------------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
