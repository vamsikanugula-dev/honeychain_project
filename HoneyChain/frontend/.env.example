# ===========================================================================
# HoneyChain frontend — environment template
# Copy to `frontend/.env` for local development.
#
# IMPORTANT: Vite only exposes variables prefixed with VITE_ to the browser.
# Never place a secret here — everything in this file is public once built.
# The JWT secret, database URL and API keys belong to the backend only.
# ===========================================================================

# Application identity
VITE_APP_NAME=HoneyChain
VITE_APP_TAGLINE=Blockchain-powered honey traceability and AI-assisted smart beekeeping

# API base path. Leave as `/api/v1` for local development: the Vite dev server
# proxies it to the backend, keeping requests same-origin (cookies work without
# CORS). For a deployed build, either keep the same-origin proxy in your web
# server or set the absolute API origin, e.g. https://api.honeychain.example.gov.in/api/v1
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards `/api` requests (server-side only).
VITE_PROXY_TARGET=http://localhost:8000

# Milliseconds between background health probes of the API.
VITE_HEALTH_POLL_INTERVAL=60000

# Absolute URLs used by the landing page's "Government / KVIC" links.
VITE_KVIC_URL=https://www.kvic.gov.in
