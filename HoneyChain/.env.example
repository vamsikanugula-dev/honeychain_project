# ===========================================================================
# HoneyChain — root environment template
#
# The backend and frontend each own their configuration:
#   backend/.env.example   → API, database, JWT, CORS, IoT/AI/blockchain settings
#   frontend/.env.example  → build-time client configuration (no secrets)
#
# This root file exists for tooling that expects a repository-level .env, such
# as `docker compose` or a deployment script that injects one shared file. The
# backend reads it as the lowest-priority source (see backend/app/core/config.py).
#
# Copy to `.env` and fill in real values. NEVER commit the filled-in file.
# ===========================================================================

# Umbrella switch read by the backend (development | testing | production).
HONEYCHAIN_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://honeychain:change-me@localhost:5432/honeychain_dev

# ---------------------------------------------------------------------------
# Authentication — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Origins (CORS on the API side; the frontend proxy uses VITE_PROXY_TARGET)
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Hyperledger Fabric traceability (backend-only; never expose this to the SPA)
# ---------------------------------------------------------------------------
BLOCKCHAIN_BASE_URL=http://54.160.152.176:3001
BLOCKCHAIN_TIMEOUT_MS=10000
BLOCKCHAIN_RETRY_ATTEMPTS=3
BLOCKCHAIN_ENABLED=true
LAB_ALLOW_RISK_OVERRIDE=true

# Legacy placeholders accepted by the backend for backwards compatibility.
BLOCKCHAIN_NETWORK=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# IoT telemetry (Phase 3 — implemented)
#
# The MQTT broker is OPTIONAL. Leave MQTT_BROKER_URL empty and the API, the HTTP
# ingest endpoint (POST /api/v1/iot/telemetry) and every dashboard still work;
# GET /api/v1/health/mqtt then answers "not_configured" and says so in words.
# Set it to a broker host to receive device packets over MQTT as well.
# ---------------------------------------------------------------------------
MQTT_BROKER_URL=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=honeychain-backend
# Root of every topic: <prefix>/devices/{device_id}/{telemetry|status|commands|config}
MQTT_TOPIC_PREFIX=honeychain
MQTT_USE_TLS=false
MQTT_KEEPALIVE_SECONDS=60
MQTT_RECONNECT_SECONDS=5
# Set false to run the API without the consumer thread (e.g. a dedicated consumer process)
MQTT_CONSUMER_ENABLED=true

# Device health. A device that has not reported for this long is OFFLINE, so a
# device that goes quiet stops looking healthy by itself.
DEVICE_OFFLINE_THRESHOLD_SECONDS=900
# Battery at or below this percentage makes a reporting device WARNING.
DEVICE_LOW_BATTERY_PERCENT=20

# Ingest limits. Values outside the sensor validity ranges are rejected with 422,
# never clamped; a payload larger than this is refused before it is parsed.
TELEMETRY_MAX_PAYLOAD_BYTES=8192
# A timestamp further into the future than this is treated as a clock error.
TELEMETRY_MAX_CLOCK_SKEW_SECONDS=300
# Telemetry is audited at most this often (per device) to keep audit_logs meaningful.
TELEMETRY_AUDIT_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# AI (Phase 5 — placeholder)
# ---------------------------------------------------------------------------
AI_API_KEY=
